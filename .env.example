# Copy to .env for local development. In production (Render) set these in the dashboard.
# The Django backend is the single origin every frontend talks to.

# --- PostgreSQL ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
DEBUG=False
JWT_SECRET=
ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:3200
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://mechanicsbackend.onrender.com

# --- Redis (Render Key Value; leave empty locally to use in-memory channels) ---
REDIS_URL=
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# --- OAuth / redirects ---
STORE_REDIRECT_URL=http://localhost:3100
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
